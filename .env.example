# Copie este arquivo para .env e preencha localmente. Nunca coloque senhas aqui no Git.
# Para Render Free, prefira o envio por HTTPS via Resend (SMTP nas portas 25, 465 e 587 é bloqueado).
RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO=

# SMTP continua disponível para ambientes que permitem a conexão de saída.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=587
# No Yahoo, use o endereço completo da conta e uma senha de aplicativo.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
